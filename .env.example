# --- Overrides -----------------------------------------------------------
# Base URL for the portal's sandbox API calls (app/lib/api.js).
# Default is the built-in sandbox served from the same origin (/api/v1).
NEXT_PUBLIC_API_BASE=

# Cross-chain stand uses the fixed upstream in lib/crosschain-config.mjs through
# /api/crosschain/* (GET only). Do not point NEXT_PUBLIC_API_BASE at the indexer:
# the sandbox /api/v1 contract and the cross-chain /v1 contract are different.
# Pinned deployments and readiness checks: docs/CROSSCHAIN-STAND.md.

# Native routes work directly; NEXT_PUBLIC_BASE_PATH is no longer used.
# Optional public links for installations that also host marketing/docs.
NEXT_PUBLIC_MARKETING_URL=https://thesauros.io
NEXT_PUBLIC_DOCS_URL=https://docs.thesauros.io

# The unified product reads the original monitor and DeFiLlama through
# lib/live-data.mjs; no browser-side source credentials are required.

# Wallet sign-in for Individual. Institution is coming soon.
# Generate a unique secret before running scripts/init-auth.mjs.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8879
# Store outside public/ and outside the marketing server's static roots.
THESAUROS_AUTH_DB=../private-state/accounts.sqlite

# Existing public WalletConnect project is used by default; override if needed.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional Turso storage. Both auth and test workspaces use this database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

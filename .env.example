# --- Data source ---------------------------------------------------------
# sandbox (default): the portal reads from the built-in simulation API.
# real: the portal reads live data from the Thesauros Partner API through
# the same-origin proxy below (Overview, API Keys, Users, Analytics).
NEXT_PUBLIC_DATA_SOURCE=sandbox

# --- Real Partner API ----------------------------------------------------
# Where the Next.js server proxies real-data calls.
# /api/v1/real/*  -> PARTNER_API_URL/api/v1/*   (NEXT_PUBLIC_DATA_SOURCE=real)
# /api/v1/partners/*, /api/v1/partner/* -> PARTNER_API_URL (always proxied)
PARTNER_API_URL=https://partner-api-production-10ad.up.railway.app

# --- Real-mode admin proxy -----------------------------------------------
# Credential for the Partner API surfaces the portal cannot call with a
# browser-held key: key management (keys:admin) and the read-only partner
# endpoints behind Users + Analytics. Read server-side only by
# app/api/admin/[...path]/route.js — never expose it to the client (no
# NEXT_PUBLIC_ prefix, no import from client code).
# Unset: /api/admin/* answers 503 and the portal ships no credential at all.
# The proxy pins POST /keys to environment:"test" and ignores any client-supplied
# value: this portal has no sign-in, so it cannot attribute a live key to anyone.
# Live keys are issued by the account app's self-serve onboarding path.
PARTNER_ADMIN_KEY=

# --- Account app (real mode) ---------------------------------------------
# Where a partner creates their own tsk_live_ key. Linked from Quickstart and
# API Keys in real mode; the portal never mints live keys itself.
NEXT_PUBLIC_ACCOUNT_APP_URL=https://b2b.thesauros.io/app/institution

# --- Monitoring service (on-chain metrics) -------------------------------
# /api/v1/monitor/* -> MONITOR_API_URL/api/*  (public, no auth)
# Feeds Overview + Vaults with live on-chain TVL / APY / vault state.
MONITOR_API_URL=https://bastardgreeks.thesauros.io

# --- Overrides -----------------------------------------------------------
# Base URL for the portal's sandbox API calls (app/lib/api.js).
# Default is the built-in sandbox served from the same origin (/api/v1).
NEXT_PUBLIC_API_BASE=/api/v1

# --- Overrides -----------------------------------------------------------
# Base URL for the portal's sandbox API calls (app/lib/api.js).
# Default is the built-in sandbox served from the same origin (/api/v1).
NEXT_PUBLIC_API_BASE=

# The vault uses the fixed upstream in lib/crosschain-config.mjs through
# /api/crosschain/* (GET only). Do not point NEXT_PUBLIC_API_BASE at the indexer:
# the sandbox /api/v1 contract and the vault's /v1 contract are different.
# Pinned deployments and readiness checks: docs/CROSSCHAIN-STAND.md.
# Deposits follow the vault contract: open unless it is paused. Set this to
# "closed" at build time to close them in the app, for example while contracts
# are being changed. Withdrawing, collecting and cancelling always work.
# NEXT_PUBLIC_THESAUROS_DEPOSITS=closed
# Where the Vault page reads money movements between networks.
# CROSSCHAIN_OPS_API=https://xc-api.sandbox-test-1488.thesauros.io

# Native routes work directly; NEXT_PUBLIC_BASE_PATH is no longer used.
# Optional public links for installations that also host marketing/docs.
NEXT_PUBLIC_MARKETING_URL=https://thesauros.io
NEXT_PUBLIC_DOCS_URL=https://docs.thesauros.io

# The app reads the Thesauros monitor (lib/live-data.mjs), the team's data API
# (lib/insights.mjs) and its own indexer; no outside data service and no
# browser-side source credentials.

# Wallet sign-in for Individual. Wallet or email sign-in for Institution.
# Generate a unique secret before running scripts/init-auth.mjs.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8879
# Store outside public/ and outside the marketing server's static roots.
THESAUROS_AUTH_DB=../private-state/accounts.sqlite

# Existing public WalletConnect project is used by default; override if needed.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional Turso storage. Both auth and test workspaces use this database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional keyed RPC endpoints, comma-separated, per network (ETHEREUM, ARBITRUM,
# BASE, MONAD, PLASMA). They replace the public lists in lib/chains.mjs for
# reads, archive reads and log scans. Public endpoints do not return event
# history for Base and Monad.
# THESAUROS_RPC_BASE=https://...

# Optional private read-only RPCs, loaded only at runtime on the server.
# Never prefix these with NEXT_PUBLIC_ or place credentials in client config.
# Browser reads use the authenticated /api/migration/rpc/{base,arbitrum} proxy;
# missing/unavailable private endpoints fall back to the pinned public RPCs.
# URLS accepts at most six comma-separated HTTPS endpoints, tried in order.
# The singular URL settings are used when the corresponding URLS is empty.
MIGRATION_BASE_RPC_URLS=
MIGRATION_ARBITRUM_RPC_URLS=
MIGRATION_BASE_RPC_URL=
MIGRATION_ARBITRUM_RPC_URL=

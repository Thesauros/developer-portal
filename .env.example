# Base URL for the portal's API calls (app/lib/api.js).
# Default is the built-in sandbox served from the same origin (/api/v1).
# Point this at a real Thesauros API deployment to integrate with live data,
# e.g. NEXT_PUBLIC_API_BASE=https://developer.thesauros.io/api/v1
NEXT_PUBLIC_API_BASE=/api/v1

# Real partner API (NestJS, developer.thesauros.io backend repo).
# Next.js rewrites /api/v1/partners/* and /api/v1/partner/* to this URL.
PARTNER_API_URL=http://localhost:3001
